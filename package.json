{
  "name": "fill-out--your-app-name",
  "version": "0.0.0",
  "description": "fill-out--description",
  "main": "server/init.ts",
  "scripts": {
    "build": "esbuild client/init.ts --minify --bundle --outfile=public/js/init.js",
    "build:watch": "npm run -s build -- --watch",
    "jest": "node --experimental-vm-modules --no-warnings ./node_modules/.bin/jest",
    "lint": "npm run -s lint:syntax && npm run -s lint:types",
    "lint:syntax": "eslint \"**/*.ts\" --ignore-pattern \"public/**\" && echo \"✓ Linted syntax and styling\"",
    "lint:types": "tsc && echo \"✓ Linted types\"",
    "start": "node --experimental-strip-types server/init.ts",
    "start:dev": "node --experimental-strip-types --watch server/init.ts",
    "test": "npm run -s lint && npm run -s test:coverage",
    "test:coverage": "npm run -s jest -- --coverage --collectCoverageFrom=\"./server/**\"",
    "test:watch": "npm run -s jest -- --watch",
    "prepare": "husky"
  },
  "type": "module",
  "prepare": "husky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leafrogers/fill-out--your-app-name.git"
  },
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "helmet": "^8.0.0",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.11.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "esbuild": "^0.24.0",
    "eslint-plugin-jest": "^28.8.3",
    "globals": "^15.9.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "nock": "^13.5.5",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  },
  "engines": {
    "node": "^22.x.x"
  }
}
